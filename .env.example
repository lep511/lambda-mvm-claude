# claude-agent — environment variables
#
# Usage:
#   cp .env.example .env     # then edit
#   set -a; source .env; set +a
#
# This file is meant to be SOURCED by bash, not parsed by a dotenv library:
# some values reference $AWS_ACCOUNTID, which only expands in a shell. There is
# no dotenv loading in the scripts — they read the ambient environment and
# hard-fail on anything required that is missing, the same as every other lab
# in this repo.
#
# In the workshop's code editor the four REQUIRED variables are already in
# .bashrc, so you normally need this file only to override an optional knob.
#
# NOTE: none of these decide what the agent DOES. That is ./agent-prompt.md,
# which run-agent.sh uploads with every run — it is job input, not
# configuration, and changing it needs no rebuild.
#
# Each entry notes which script reads it. "rebuild" means the value is baked
# into the MicroVM image, so changing it means re-running agent/build-image.sh.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — provisioned out-of-band by the workshop's common.yml stack
# ─────────────────────────────────────────────────────────────────────────────

# Region everything is deployed into.
#   read by: every script
AWS_REGION=us-east-1

# Your workshop account. Several defaults below are derived from it.
#   read by: every script
AWS_ACCOUNTID=123456789012

# Bucket the image source zip and the per-run input/artifacts live in.
# Defaults to the derived name if unset, so you can usually leave this alone.
#   read by: build-image.sh, test-image.sh, run-agent.sh, grant-permissions.sh
ARTIFACTS_BUCKET=lambda-mvm-workshop-artifacts-${AWS_ACCOUNTID}

# Role the lambda-microvms service assumes to BUILD the image server-side.
# No default — build-image.sh hard-fails without it.
#   read by: agent/build-image.sh
MODULE2_REVIEWER_BUILD_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNTID}:role/Module2ReviewerBuildRole-workshop

# Role the MicroVM RUNS as. It must be Module2ReviewerBuildRole-workshop: it is
# the only workshop role with bedrock:InvokeModel*. grant-permissions.sh adds
# the S3 access and lambda:TerminateMicrovm this lab needs on top.
#   read by: grant-permissions.sh, run-agent.sh, agent/test-image.sh
MVM_EXECUTION_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNTID}:role/Module2ReviewerBuildRole-workshop

# NOT needed by this lab: KIRO_API_KEY_SECRET_ARN. Claude Code reaches Bedrock
# with the execution role's credentials, so there is no API key anywhere in
# this module — not in the image, not in Secrets Manager.


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — baked into the image (rebuild to change)
# ─────────────────────────────────────────────────────────────────────────────

# Bedrock model the agent runs on. Any Claude inference profile enabled in the
# account works; AmazonBedrockFullAccess is attached, so IAM does not restrict
# the choice. Cheaper alternative: us.anthropic.claude-sonnet-4-6.
#   read by: agent/build-image.sh (rebuild)
ANTHROPIC_MODEL=us.anthropic.claude-opus-5

# Seconds for one `claude -p` run. Kept below the lifetime of the credentials
# the agent is handed. A timeout is terminal, not retried.
#   read by: agent/build-image.sh (rebuild)
CLAUDE_TIMEOUT=1500

# Retries when the CLI exits non-zero, which is usually a transient Bedrock
# error rather than a real failure.
#   read by: agent/build-image.sh (rebuild)
CLAUDE_MAX_ATTEMPTS=3

# MicroVM memory. 2048 is the value every other lab in this workshop runs on.
# Raise to 4096 if the agent dies partway through a large input set.
#   read by: agent/build-image.sh (rebuild)
MVM_MEMORY_MIB=2048

# Image name, which also decides the log group:
# /aws/lambda-microvms/$IMAGE_NAME. Change both the build and the test/run
# scripts together, or they will look for the wrong logs.
#   read by: agent/build-image.sh, agent/test-image.sh, run-agent.sh
IMAGE_NAME=mvm-claude-agent

# Do NOT put IMAGE_VERSION in this file. build-image.sh does not take one: the
# service assigns it — 1.0 for a new image, then the next major for each rebuild
# (the first one yields 2.0) — and the script persists what it built as
# AGENT_IMAGE_VERSION in /etc/profile.d/claude-agent-image.sh, which the other
# two scripts prefer.
#
# The reason it is a trap and not just a redundancy: this file is meant to be
# sourced with `set -a`, so an IMAGE_VERSION line here gets EXPORTED into your
# shell and stays there. Every later run in that shell would pin itself to the
# old version and silently execute stale code — the job succeeds, it just runs
# yesterday's image. The scripts now let AGENT_IMAGE_VERSION win and print a
# NOTE when they ignore a stale pin, but the cleanest fix is not to set it.
#
# To run an old version on purpose, pass the variable the scripts actually read:
#   AGENT_IMAGE_VERSION=2.0 ./run-agent.sh


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — launch-time, no image rebuild needed
# ─────────────────────────────────────────────────────────────────────────────

# The task definition: the file uploaded as the agent's prompt. Keeping a
# directory of them (prompts/) is how one image serves several jobs; --prompt
# overrides this per invocation.
#
# ALWAYS relative to this directory, claude-agent/ — not to the script you are
# running. build-image.sh lives in agent/ and resolves the path against the lab
# root on purpose, so this one exported value means the same file to both
# scripts. e.g. PROMPT_FILE=prompts/xls-analysis.md works for either.
#
# Pointing this at a library file is the alternative to promote-by-copy: the
# active task then has no duplicate at the lab root. The trade-off is that .env
# is not tracked, so which task is active stops being visible in git.
#   read by: run-agent.sh, agent/build-image.sh (which also bakes it in as the
#            fallback used when a job passes no prompt_uri)
PROMPT_FILE=agent-prompt.md

# Value for the prompt's {{LANGUAGE}} placeholder. One of: es, en, pt, fr, de,
# it — or 'source' to have the agent match the input's own language. Anything
# else is passed through verbatim ("Catalan" works). Per-run equivalent:
#   ./run-agent.sh --var LANGUAGE=en
# build-image.sh bakes this as the image default, run-agent.sh overrides it at
# launch, and --var beats both.
#   read by: run-agent.sh, agent/build-image.sh
AGENT_LANGUAGE=es

# MicroVM idlePolicy window, passed to run-microvm. A BACKSTOP only: the agent
# terminates its own VM as soon as the job is done. This is what catches a VM
# that crashed before it could. It still has to outlast a whole run, because
# the agent gets no inbound request while it works — a short window would reap
# the VM mid-job.
#   read by: run-agent.sh
MVM_MAX_IDLE_SECONDS=1800

# How long run-agent.sh watches for a result, in 10-second polls (150 = 25
# min). A timeout does not lose the run — the agent keeps working and still
# owns its VM. Re-fetch it with
#   ./run-agent.sh --fetch <run-id>
#   read by: run-agent.sh
POLL_ATTEMPTS=150


# ─────────────────────────────────────────────────────────────────────────────
# SET AUTOMATICALLY — do not put this in .env
# ─────────────────────────────────────────────────────────────────────────────
#
# AGENT_IMAGE_ARN   agent/build-image.sh writes it to
#                   /etc/profile.d/claude-agent-image.sh on success, and
#                   test-image.sh / run-agent.sh re-source that file. Setting
#                   it by hand only risks running against a stale image.
